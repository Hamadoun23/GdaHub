# Secrets et configuration locale
.env
*.pem

# L'organigramme reel — noms, adresses, rattachements — est une donnee, pas
# du code. Seul l'exemple anonyme est publie.
infra/effectif/personnel.json

# Les sauvegardes de production. Elles portent les noms, les adresses et les
# empreintes de mots de passe de tout le personnel : elles n'ont rien a faire
# dans un depot, meme prive.
infra/reprise/*.sql
infra/reprise/*.sql.gz

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Django
staticfiles/
media/
*.sqlite3

# Node / Next
node_modules/
.next/
out/
*.tsbuildinfo

# Outils
.DS_Store
.idea/
.vscode/

