# Variables de la pile de developpement. Copiez ce fichier en « .env » a cote
# du docker-compose.yml. Les valeurs ci-dessous conviennent en local ; aucune
# ne doit se retrouver telle quelle sur un serveur.

# Mot de passe partage par les cinq bases Postgres locales.
POSTGRES_PASSWORD=gdahub-local

# Cle de signature Django. En production, une valeur tiree au sort et unique
# par service.
DJANGO_SECRET_KEY=developpement-local-non-secret

# Compte administrateur cree au premier demarrage d'identity, puis a changer
# depuis l'application.
GDAHUB_ADMIN_IDENTIFIANT=admin
GDAHUB_ADMIN_MOT_DE_PASSE=admin

# En developpement, les regles de complexite des mots de passe genent la
# creation de comptes de test. A laisser sur False en production.
DJANGO_MOTS_DE_PASSE_SIMPLES=True

# Nombre de tentatives de connexion tolerees par minute et par adresse.
GDAHUB_LIMITE_CONNEXION=10/min
