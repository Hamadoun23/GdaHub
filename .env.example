# Variables de la pile de developpement. Copiez ce fichier en « .env » a cote
# du docker-compose.yml. Les valeurs ci-dessous conviennent en local ; aucune
# ne doit se retrouver telle quelle sur un serveur.

# Mot de passe partage par les neuf bases Postgres locales.
POSTGRES_PASSWORD=gdahub-local

# Cle de signature Django. En production, une valeur tiree au sort et unique
# par service.
DJANGO_SECRET_KEY=developpement-local-non-secret

# Super administrateur cree au premier demarrage d'identity. C'est une
# personne nommee, pas un compte de service : le journal des connexions reste
# lisible des la premiere seance. Mot de passe a changer des la connexion.
GDAHUB_ADMIN_IDENTIFIANT=hcisse@gdamali.net
GDAHUB_ADMIN_MOT_DE_PASSE=admin
GDAHUB_ADMIN_NOM=Cisse
GDAHUB_ADMIN_PRENOM=Hamadoun
GDAHUB_ADMIN_FONCTION=Responsable IT et developpement

# En developpement, les regles de complexite des mots de passe genent la
# creation de comptes de test. A laisser sur False en production.
DJANGO_MOTS_DE_PASSE_SIMPLES=True

# Nombre de tentatives de connexion tolerees par minute et par adresse.
GDAHUB_LIMITE_CONNEXION=10/min

# Les applications rassemblees par le hub vivent dans leur propre fichier.
# Les joindre ici evite d'avoir a passer « -f » a chaque commande.
#
# Le separateur est declare : compose prend « : » sur Linux et « ; » sur
# Windows, et un chemin comme « C:\... » rend le premier ambigu. L'ecrire
# explicitement fait marcher le meme fichier sur les deux.
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker-compose.applications.yml
